+    if (!parsedDraft || typeof parsedDraft !== 'object') {
+      return null;
+    }
+
+    return normalizeEditArticleDraft(parsedDraft);
+  } catch {
+    return null;
+  }
+};
+
+const persistEditArticleDraft = (slug: string, draft: EditArticleDraft) => {
